{% assign selected_variant = product.selected_or_first_available_variant %}

{% if product %}
  <div
    class="lenscraft-customize"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
  >
    <button
      type="button"
      class="lenscraft-customize__button"
      data-lenscraft-customize
    >
      Customize Lens
    </button>
  </div>

  <style>
    .lenscraft-customize {
      width: 100%;
      margin: 12px 0;
    }

    .lenscraft-customize__button {
      width: 100%;
      padding: 14px 20px;
      border: 0;
      border-radius: 5px;
      background: #000;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    .lenscraft-customize__button:hover {
      background: #292929;
    }
  </style>

  <script>
    (() => {
      const block = document.currentScript?.closest('.shopify-section')?.querySelector('.lenscraft-customize');

      if (!block) return;

      const button = block.querySelector('[data-lenscraft-customize]');

      button?.addEventListener('click', () => {
        const productForm = document.querySelector('form[action*="/cart/add"]');

        const variantInput = productForm?.querySelector('[name="id"]');
        const variantId = variantInput?.value || block.dataset.variantId;
        const productId = block.dataset.productId;

        if (!productId || !variantId) {
          alert('Please select a frame colour first.');
          return;
        }

        button.disabled = true;
        button.textContent = 'Loading lens options…';

        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/apps/lenscraftclone';

        for (const [name, value] of Object.entries({ productId, variantId })) {
          const input = document.createElement('input');
          input.type = 'hidden';
          input.name = name;
          input.value = value;
          form.appendChild(input);
        }

        document.body.appendChild(form);
        form.submit();
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Customize Lens Clone",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a Customize Lens button to a product page."
    }
  ]
}
{% endschema %}
