{% assign selected_variant = product.selected_or_first_available_variant %}

{% if product %}
  <div
    class="lenscraft-customize"
    data-product-id="{{ product.id }}"
    data-variant-id="{{ selected_variant.id }}"
    data-currency="{{ cart.currency.iso_code | escape }}"
    data-country="{{ localization.country.iso_code | escape }}"
  >
    <button
      type="button"
      class="lenscraft-customize__button"
      data-lenscraft-customize
    >
      Customize Lens Studio
    </button>
  </div>

  <style>
    .lenscraft-customize {
      width: 100%;
      margin: 12px 0;
    }

    .lenscraft-customize__button {
      width: 100%;
      padding: 14px 20px;
      border: 0;
      border-radius: 5px;
      background: #000;
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
    }

    .lenscraft-customize__button:hover {
      background: #292929;
    }
  </style>

  <script>
    (() => {
      const block = document.currentScript?.closest('.shopify-section')?.querySelector('.lenscraft-customize');

      if (!block) return;

      const button = block.querySelector('[data-lenscraft-customize]');

      button?.addEventListener('click', () => {
        const productForm = document.querySelector('form[action*="/cart/add"]');

        const variantInput = productForm?.querySelector('[name="id"]');
        const urlVariant = new URLSearchParams(window.location.search).get('variant');
        const variantId = variantInput?.value || urlVariant || block.dataset.variantId;
        const productId = block.dataset.productId;

        if (!productId || !variantId) {
          alert('Please select a frame colour first.');
          return;
        }

        button.disabled = true;
        button.textContent = 'Loading lens options…';

        const params = new URLSearchParams({
          productId: String(productId),
          variantId: String(variantId),
        });
        const currency = block.dataset.currency;
        if (currency) params.set('currency', currency);
        const country = block.dataset.country;
        if (country) params.set('country', country);
        window.location.href = `/apps/lenscraftclone?${params}`;
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Customize Lens Studio",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a Customize Lens button to a product page."
    }
  ]
}
{% endschema %}
